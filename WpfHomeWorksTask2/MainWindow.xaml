<Window x:Class="WpfHomeWorksTask2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHomeWorksTask2"
        mc:Ignorable="d"
        Title="Простой текстовый редактор" Height="500" Width="600" MinWidth="300" MinHeight="300" Closing="Window_Closing">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button 
                Content="Открыть" 
                Grid.Column="0"
                Background="#FFDEDCDC"
                Margin="10,10,5,10"
                Padding="5" 
                Click="Button_Click_1"/>
            <Button 
                Content="Сохранить как" 
                Grid.Column="1"
                Background="#FFDEDCDC"
                Margin="5,10"
                Padding="5" Click="Button_Click_2"/>
            <Button 
                Content="О программе" 
                Grid.Column="2"
                Background="#FFDEDCDC"
                Margin="5,10"
                Padding="5" 
                Click="Button_Click"/>

        </Grid>
        <Grid 
            DockPanel.Dock="Bottom" 
            Background="#FFDEDCDC">
            <TextBlock Name="StatusBar"
                Text="Строка состояния" 
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="2"
                Padding="2"/>
        </Grid>
        <Grid>
            <TextBox
                Name="TextRedactor"
                Text="Выверите файл для редактирования текста или напишите его самостоятельно"
                Margin="10,0,10,10"
                Padding="5"
                AcceptsReturn="True"
                AcceptsTab="True"
                ScrollViewer.CanContentScroll="True" 
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>

</Window>
