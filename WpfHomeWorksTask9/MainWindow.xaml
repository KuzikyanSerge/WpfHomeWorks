<Window x:Class="WpfHomeWorksTask9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHomeWorksTask9"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding Command="local:CustomCommands.ChangeColor" Executed="ChangeColorExecuted"/>
        <CommandBinding Command="Undo" Executed="UndoExecuted" CanExecute="UndoCanExecuted"/>
    </Window.CommandBindings>
    <Grid x:Name="Grid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="Действия" Height="50" FontSize="20" >
                <MenuItem Header="Изменить цвет" Height="50" Command="local:CustomCommands.ChangeColor"/>
                <MenuItem Header="Отменить" Height="50" Command="Undo"/>
            </MenuItem>
        </Menu>
        <Button Grid.Row="1"
            Content="Изменить цвет"
            Height="50"
            Width="200"
            VerticalAlignment="Bottom"
            Margin="25"
            FontSize="20"
            Command="local:CustomCommands.ChangeColor"/>
        <Button Grid.Row="2"
            Content="Отменить"
            Height="50"
            Width="200"
            VerticalAlignment="Top"
            Margin="25"
            FontSize="20"
            Command="Undo"/>
    </Grid>
</Window>
