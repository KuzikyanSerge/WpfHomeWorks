<Window x:Class="WpfHomeWorks6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHomeWorks6"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="300">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>
    
    <StackPanel>
        <TextBox x:Name="textVvod"
                 Margin="10"/>
        <CheckBox x:Name="chkBox"
                  Margin="10"
                  Content="Показать детали"/>
        <StackPanel Visibility="{Binding ElementName=chkBox, Path=IsChecked, Converter={StaticResource Vis}}">
            
            <TextBlock x:Name="textVivod"
                       Margin="10"
                       Text="{Binding StringFormat=Длина текста: {0}, ElementName=textVvod, Path=Text.Length, Mode=OneWay}"/>
            <ProgressBar x:Name="bar"
                     Margin="10"
                     Minimum="0"
                     Maximum="100"
                     Height="20"
                     Value="{Binding ElementName=textVvod, Path=Text.Length, Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</Window>
