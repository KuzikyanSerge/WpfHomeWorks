<Window x:Name="window" x:Class="WpfHomeWorksTask3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHomeWorksTask3"
        mc:Ignorable="d"
        Title="Выбор курса"
        WindowStartupLocation="CenterScreen"
        Height="400" Width="400" MinWidth="300" MinHeight="370">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label 
            Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Имя студента:" 
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            Margin="10,0"
            Padding="5"/>
        <TextBox 
            Name="NameStudent"
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Margin="10,0,10,0"
            Padding="5"/>
        <Label 
            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Факультет:" 
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            Margin="10,0"
            Padding="5"/>
        <ComboBox Name="KursComboBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" Padding="5" SelectionChanged="KursComboBox_SelectionChanged">
            <ComboBoxItem>Программирование</ComboBoxItem>
            <ComboBoxItem>Дизайн</ComboBoxItem>
            <ComboBoxItem>Менеджмент</ComboBoxItem>
        </ComboBox>
        <Label 
            Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Доступные курсы:" 
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            Margin="10,0"
            Padding="5"/>

        <ListBox Name="ProgListBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" Visibility="Hidden" SelectionMode="Multiple">
            <ListBoxItem>Программирование C#</ListBoxItem>
            <ListBoxItem>Программирование Pyton</ListBoxItem>
            <ListBoxItem>Программирование C++</ListBoxItem>
        </ListBox>
        <ListBox Name="DesListBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" Visibility="Hidden" SelectionMode="Multiple">
            <ListBoxItem>Adobe Photoshop</ListBoxItem>
            <ListBoxItem>Figma</ListBoxItem>
            <ListBoxItem>Blender</ListBoxItem>
        </ListBox>
        <ListBox Name="ManListBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,10,0" Visibility="Hidden" SelectionMode="Multiple">
            <ListBoxItem>Управление персоналом</ListBoxItem>
            <ListBoxItem>Управление проектом</ListBoxItem>
            <ListBoxItem>Формирование отчетов</ListBoxItem>
        </ListBox>
        <Label
            Name="KolChasov"
            Grid.Row="6" Grid.Column="0"
            Content="Количество часов:" 
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            Width="Auto"
            Margin="10,0,0,0"
            Padding="5"/>
        <Slider 
            Name="Chasy"
            Grid.Row="6" Grid.Column="1"
            Minimum="1" Maximum="40"
            Margin="0,10,10,10" 
            ValueChanged="Slider_ValueChanged"/>
        <RadioButton 
            Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="10,0"
            GroupName="TipObucheniya" Content="Очно" IsChecked="True"/>
        <RadioButton 
            Name="Zaochno"
            Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
            HorizontalAlignment="Left" VerticalAlignment="Center"
            Margin="70,0"
            GroupName="TipObucheniya" Content="Заочно"/>
        <CheckBox
            Name="CheckBox"
            Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Я слгласен(а) на обработку данных" 
            VerticalAlignment="Center"
            Margin="10,10"/>
        <Button 
            Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
            Content="Записаться"
            VerticalAlignment="Center"
            Margin="10,0,10,10"
            Padding="5" Click="Button_Click"/>

    </Grid>
</Window>
