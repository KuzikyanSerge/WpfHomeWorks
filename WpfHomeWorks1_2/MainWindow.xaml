<Window x:Class="WpfHomeWorksTask1_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHomeWorks1_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="200">
    <Grid>
        <Ellipse 
            Name="Red"
            HorizontalAlignment="Center" 
            Height="100" 
            Margin="0,50,0,0"
            VerticalAlignment="Top" 
            Width="100" 
            Stroke="Black" 
            Fill="Gray"/>
        <Ellipse 
            Name="Yellow" 
            HorizontalAlignment="Center" 
            Height="100" 
            Margin="0,200,0,0"
            VerticalAlignment="Top" 
            Width="100" 
            Stroke="Black" 
            Fill="Gray"/>
        <Ellipse 
            Name="Green" 
            HorizontalAlignment="Center" 
            Height="100" 
            Margin="0,350,0,0"
            VerticalAlignment="Top" 
            Width="100" 
            Stroke="Black" 
            Fill="Gray"/>
        <Button 
            Content="Next" 
            HorizontalAlignment="Center" 
            Margin="0,500,0,0" 
            VerticalAlignment="Top" 
            Height="40" 
            Width="100" Click="Button_Click"/>

    </Grid>
</Window>
